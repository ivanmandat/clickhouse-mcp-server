# Пример настроек. Секретов здесь нет и быть не должно: пароли и токены
# лежат в каталоге secrets/, сюда попадают только указатели на файлы.
#
# На Linux этот файл создаётся автоматически скриптом scripts/setup.sh.

CH_ADMIN_USER=default
CH_DASHBOARD_USER=dashboard
CH_HTTP_PORT=8123
CH_NATIVE_PORT=9000
CH_CONTAINER=mcp-clickhouse
# слои, видимые агенту; у вас они могут называться иначе
CH_ALLOWED_DATABASES=core,mart
# TLS обязателен, когда ClickHouse на другом сервере
CH_SECURE=false
CH_DASHBOARD_PASSWORD_FILE=secrets/ch_dashboard_password
CH_ADMIN_PASSWORD_FILE=secrets/ch_admin_password

PG_SUPERUSER=postgres
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DATABASE=mcp_dwh
PG_DSN_FILE=secrets/pg_dsn_local

GF_PORT=3000
GF_ADMIN_USER=admin
GF_URL=http://127.0.0.1:3000
GF_DATASOURCE_UID=clickhouse-dwh
GF_ADMIN_PASSWORD_FILE=secrets/gf_admin_password

# stdio — клиент запускает процесс сам; http — сервер на стороне заказчика
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8765
MCP_AUTH_TOKEN_FILE=secrets/mcp_auth_token
